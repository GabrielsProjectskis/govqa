# Copy this file to .env and fill it in. .env is git-ignored.

# Any LiteLLM model string: https://docs.litellm.ai/docs/providers
# Leave LLM_MODEL empty to run in retrieval-only mode (no key needed).
LLM_MODEL=gemini/gemini-2.5-flash
# Optional: a different (ideally stronger) model for the judge. Defaults to LLM_MODEL.
JUDGE_MODEL=

# The key for the provider you chose above. Only one is needed.
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Retrieval configuration served by the API (defaults were chosen on the dev split).
# GOVQA_CHUNK_WORDS=200
# GOVQA_METHOD=dense
# GOVQA_TOP_K=5
